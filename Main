import java.io.FileNotFoundException;
import java.util.ArrayList;

public class Main {
    public static void main(String[] args) throws FileNotFoundException {
        //Print ALL of the Insert Statements
        ArrayList<Rooms> RoomList = Maker.makeRooms();
        for (Rooms room : RoomList) {
            System.out.println(room.toString());
        }
        ArrayList<Department> departmentList = DepartmentData.departmentData();
        for (Department department : departmentList) {
            System.out.println(department);
        }
        ArrayList<Type> typeList = Maker.makeTypes();
        for (Type type : typeList) {
            System.out.println(type);
        }
        ArrayList<Students> studentList = Maker.studentData();
        for (Students students : studentList) {
            System.out.println(students);
        }
        ArrayList<Teachers> teacherList = Maker.teacherData();
        for (Teachers teachers : teacherList) {
            System.out.println(teachers);
        }
        ArrayList<Course> courseList = Maker.makeCourses();
        for (Course course : courseList) {
            System.out.println(course);
        }
        ArrayList<Offerings> offeringList = Maker.offeringsData();
        for (Offerings offerings : offeringList) {
            System.out.println(offerings);
        }
        ArrayList<Roster> rosterList = Maker.RosterData(offeringList,studentList);
        for (Roster roster : rosterList) {
            System.out.println(roster);
        }
    }
}
